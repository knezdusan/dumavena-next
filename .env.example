# Resend API key — create a free account at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email addresses for the contact form
# The address that sends the email (must be verified in Resend)
CONTACT_FROM_EMAIL=Dumavena <onboarding@resend.dev>

# The address that receives contact form submissions
CONTACT_TO_EMAIL=info@dumavena.com

# Cloudflare Turnstile — bot protection for the contact form
# Create a widget at: Cloudflare Dashboard → Turnstile → Add site
# NEXT_PUBLIC_ prefix exposes the site key to the browser (intended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# Secret key is server-only — NEVER add NEXT_PUBLIC_ prefix
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
